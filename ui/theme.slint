// Sunset pastels on cream. Plum ink instead of black; the darkest thing on
// screen is the black keys, and those are plum too.
export global Theme {
    out property <color> bg: #f8efe6;
    out property <color> card: #fffaf4;
    out property <color> line: #ecdccd;
    out property <color> track: #f0e2d6;
    out property <color> ink: #4a2f52;
    out property <color> soft: #8b7088;
    out property <color> faint: #b9a2b3;
    out property <color> pink: #e4618b;
    out property <color> teal: #3fa2aa;
    out property <color> peach: #f39a5b;
    out property <color> lavender: #9a7fd6;
    out property <color> gold: #e3b04f;
    out property <color> rec: #e0573f;
    out property <color> scope-bg: #f4edfb;
    out property <color> scope-grid: #e4d8f2;
    out property <color> key-white: #fffdf9;
    out property <color> key-black: #5d4768;
    out property <brush> sunset: @linear-gradient(90deg, #ffd3a3 0%, #ffaeb9 48%, #c9b0f0 100%);
    out property <brush> sun: @linear-gradient(180deg, #ffd56b 0%, #ff8f8f 70%, #f06aa0 100%);
    out property <string> font: "Barlow";
    out property <string> mono: "JetBrains Mono";
}
